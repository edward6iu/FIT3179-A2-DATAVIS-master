{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart: annual allocation ranks among six Merri-bek transport programs, 2026-27 to 2030-31. Source: Adopted Budget 2026-2030, Appendix B, PDF pages 104-105.",
  "title": {
    "text": "Transport priorities shift across the five-year plan",
    "subtitle": [
      "Merri-bek: rank within six transport programs (1 = largest allocation).",
      "Adopted Capital Works Budget, 2026-27 to 2030-31; equal allocations share rank."
    ]
  },
  "width": "container",
  "height": 360,
  "padding": {
    "left": 5,
    "right": 125,
    "top": 5,
    "bottom": 5
  },
  "data": {
    "url": "data/merri_bek_transport_budget.csv",
    "format": {
      "type": "csv",
      "parse": {
        "budget_aud": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "groupby": [
        "financial_year"
      ],
      "sort": [
        {
          "field": "budget_aud",
          "order": "descending"
        }
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "financial_year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "grid": true,
        "gridDash": [
          2,
          3
        ]
      },
      "sort": [
        "2026-27",
        "2027-28",
        "2028-29",
        "2029-30",
        "2030-31"
      ]
    },
    "y": {
      "field": "rank",
      "type": "ordinal",
      "title": "Rank",
      "axis": {
        "domain": false,
        "ticks": false,
        "labelExpr": "'#' + datum.value"
      },
      "scale": {
        "domain": [
          1,
          2,
          3,
          4,
          5,
          6
        ]
      }
    },
    "color": {
      "field": "program",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Bicycle facilities",
          "Planning & design",
          "Road safety",
          "School travel",
          "Streets for People",
          "Walking facilities"
        ],
        "range": [
          "#0284c7",
          "#0f172a",
          "#d97706",
          "#059669",
          "#7c3aed",
          "#64748b"
        ]
      }
    },
    "opacity": {
      "condition": {
        "param": "programHover",
        "empty": true,
        "value": 1
      },
      "value": 0.15
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "programHover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout",
            "fields": [
              "program"
            ],
            "nearest": true
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "interpolate": "linear"
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "tooltip": [
          {
            "field": "source_program",
            "type": "nominal",
            "title": "Program"
          },
          {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "rank",
            "type": "ordinal",
            "title": "Rank among six programs"
          },
          {
            "field": "budget_aud",
            "type": "quantitative",
            "title": "Planned allocation (AUD)",
            "format": "$,.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.financial_year === '2030-31'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 10,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "program",
          "type": "nominal"
        }
      }
    }
  ]
}
